{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "digital-banking-shell": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/digital-banking-shell",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "./node_modules/@angular/material/legacy-prebuilt-themes/legacy-indigo-pink.css",
              "src/styles.scss"
            ],
            "scripts": [],
            "optimization": {
              "scripts": true,
              "styles": true,
              "fonts": false
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "digital-banking-shell:build:production"
            },
            "development": {
              "browserTarget": "digital-banking-shell:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "digital-banking-shell:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "./node_modules/@angular/material/legacy-prebuilt-themes/legacy-indigo-pink.css",
              "src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "bofa-design-system": {
      "projectType": "library",
      "root": "projects/bofa-design-system",
      "sourceRoot": "projects/bofa-design-system/src",
      "prefix": "bds",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/bofa-design-system/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/bofa-design-system/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/bofa-design-system/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/bofa-design-system/src/test.ts",
            "tsConfig": "projects/bofa-design-system/tsconfig.spec.json",
            "karmaConfig": "projects/bofa-design-system/karma.conf.js"
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "projects/bofa-design-system/.storybook",
            "browserTarget": "bofa-design-system:build",
            "compodoc": false,
            "port": 6006,
            "styles": [
              "./node_modules/@angular/material/legacy-prebuilt-themes/legacy-indigo-pink.css"
            ]
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "projects/bofa-design-system/.storybook",
            "browserTarget": "bofa-design-system:build",
            "compodoc": false,
            "outputDir": "dist/storybook/bofa-design-system",
            "styles": [
              "./node_modules/@angular/material/legacy-prebuilt-themes/legacy-indigo-pink.css"
            ]
          }
        }
      }
    },
    "advisor-console": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/advisor-console",
      "sourceRoot": "projects/advisor-console/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/advisor-console",
            "index": "projects/advisor-console/src/index.html",
            "main": "projects/advisor-console/src/main.ts",
            "polyfills": "projects/advisor-console/src/polyfills.ts",
            "tsConfig": "projects/advisor-console/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/advisor-console/src/favicon.ico",
              "projects/advisor-console/src/assets"
            ],
            "styles": [
              "projects/advisor-console/src/styles.scss"
            ],
            "scripts": [],
            "optimization": {
              "scripts": true,
              "styles": true,
              "fonts": false
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/advisor-console/src/environments/environment.ts",
                  "with": "projects/advisor-console/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "advisor-console:build:production"
            },
            "development": {
              "browserTarget": "advisor-console:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "advisor-console:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/advisor-console/src/test.ts",
            "polyfills": "projects/advisor-console/src/polyfills.ts",
            "tsConfig": "projects/advisor-console/tsconfig.spec.json",
            "karmaConfig": "projects/advisor-console/karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/advisor-console/src/favicon.ico",
              "projects/advisor-console/src/assets"
            ],
            "styles": [
              "projects/advisor-console/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  }
}
